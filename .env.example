NEXT_PUBLIC_URL=http://localhost:3000

NEXT_PUBLIC_DELIVERY_FEE=2.50
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

WORLDPAY_API_USERNAME=
WORLDPAY_API_PASSWORD=
WORLDPAY_MERCHANT_ENTITY=
WORLDPAY_NARRATIVE_LINE1=

WORLDPAY_ENV=

# Optional. When set, /api/worldpay/webhook requires a valid Event-Signature header.
WORLDPAY_WEBHOOK_SECRET=

RESEND_API_KEY=re_...

RESEND_FROM_EMAIL=orders@your-verified-domain.com
RESTAURANT_EMAIL=orders@example.com
DELIVERY_FEE=2.50
ADMIN_MENU_KEY=

# ─── SUNMI NT311 Kitchen Cloud Printer (OpenAPI direct-push) ─────────────────
# Partner portal: https://partner.sunmi.com — create partner account, open cloud
# printer channel, then collect:
#   SUNMI_APP_ID / SUNMI_APP_KEY  — channel credentials from SUNMI
#   SUNMI_PRINTER_SN              — device serial on the NT311 (or from pairing)
#   SUNMI_SHOP_ID                 — optional shop/group id used with bindShop
# Printer must ship under your partner channel and be online (Wi‑Fi/LAN).
# empty or "live" = https://openapi.sunmi.com ; "uat" = https://uat.openapi.sunmi.com
SUNMI_APP_ID=
SUNMI_APP_KEY=
SUNMI_PRINTER_SN=
SUNMI_SHOP_ID=
SUNMI_ENV=

# Optional shared secret for POST /api/print-jobs/retry (Vercel cron / scheduled job)
CRON_SECRET=
